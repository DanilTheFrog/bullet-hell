#!/bin/bash

if [ -z "$1" ]; then
  echo "usage: newmod <module_name>"
  exit 1
fi

MODULE_NAME=$1
DIR_PATH="src/$MODULE_NAME"

mkdir -p "$DIR_PATH"

cat << 'EOF' > "$DIR_PATH/mod.rs"
mod plugin;
pub use plugin::*;

mod components;
pub use components::*;

mod resources;
mod systems;
EOF

echo "use bevy::prelude::*;" > "$DIR_PATH/systems.rs"
echo "use bevy::prelude::*;" > "$DIR_PATH/components.rs"
echo "use bevy::prelude::*;" > "$DIR_PATH/resources.rs"
echo "use bevy::prelude::*;" > "$DIR_PATH/plugin.rs"

echo "module created '$MODULE_NAME' in $DIR_PATH"